# Copy this file to .env and fill in your key. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated model fallback chain (tried in order on 429/503/404).
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# Optional: total time budget per request in ms (Netlify functions stop at 60s).
# GEMINI_TIMEOUT_MS=50000
